<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenGuard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryVariant">@color/primary_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSecondaryVariant">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="buttonStyle">@style/Widget.ScreenGuard.Button</item>
        <item name="materialButtonStyle">@style/Widget.ScreenGuard.MaterialButton</item>
    </style>

    <style name="Widget.ScreenGuard.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ScreenGuard.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_purple</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
